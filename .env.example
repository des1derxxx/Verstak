# Generate .env with: python3 scripts/setup_env.py
MONGO_ROOT_PASSWORD=
MONGO_APP_PASSWORD=
MONGODB_DATABASE=verstak
PUBLIC_ORIGIN=http://localhost:8080
BIND_ADDRESS=127.0.0.1
PORT=8080
APP_ENV=development
COOKIE_SECURE=false
ALLOW_REGISTRATION=true

# Password recovery. Leave empty until you configure your email provider.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
# starttls (usually 587) or ssl (usually 465)
SMTP_SECURITY=starttls
